{
  "name": "freebudgetapp",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @budget/web dev",
    "build": "pnpm --filter @budget/web build",
    "preview": "pnpm --filter @budget/web preview",
    "typecheck": "pnpm --filter @budget/web exec tsc -b",
    "test": "pnpm --filter @budget/web test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeappstore-online/budget.git"
  }
}
